{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTM Player",
  "version": "0.1.0",
  "identifier": "com.merhmerh.ytmplayer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "merhmerh",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser"
      }
    }
  }
}
